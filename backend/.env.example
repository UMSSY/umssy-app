# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (valores de desarrollo local)
DB_USER=user
DB_PASSWORD=password_db
DB_NAME=app_db
DB_PORT=5432
DB_HOST=localhost
DB_SCHEMA=public

# Tiempo máximo de transacción
SEED_TRANSACTION_TIMEOUT_MS=120000

# Autenticación
JWT_SECRET=super-secret-jwt-key-umssy-development-2026
JWT_EXPIRES_IN=8h
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGIN=http://localhost:3000

# Pesos del porcentaje de afinidad (valores por defecto: 60/25/10/5)
MATCH_SCORE_WEIGHT_SKILLS=60
MATCH_SCORE_WEIGHT_ACADEMIC=25
MATCH_SCORE_WEIGHT_EXPERIENCE=10
MATCH_SCORE_WEIGHT_OTHER=5

MAIL_TRANSPORT=console
MAIL_FROM_ADDRESS=no-reply@umssy.local
MAIL_FROM_NAME=UMSSY
MAIL_REPLY_TO=
# alternativa: https://dev-umssy.zer4c.dev/icons/umssy-logo-web.svg
MAIL_LOGO_URL=https://umssy.zer4c.dev/icons/umssy-logo-web.svg

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
