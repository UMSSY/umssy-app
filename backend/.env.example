# Servidor
PORT=8080
NODE_ENV=development

# Base de datos (valores de desarrollo local, los mismos que usa compose.yml)
DB_USER=user
DB_PASSWORD=password_db
DB_NAME=app_db
DB_PORT=5432
DB_HOST=localhost
DB_SCHEMA=public

# Tiempo máximo de cada transacción de módulo del seed en ms (1 a 600000; por defecto 120000)
SEED_TRANSACTION_TIMEOUT_MS=120000

# Autenticación (JWT_SECRET va vacío: genéralo como indica el README)
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ALGORITHM=HS256

# CORS (origen del frontend en desarrollo)
CORS_ORIGIN=http://localhost:3000

MAIL_TRANSPORT=console
MAIL_FROM_ADDRESS=no-reply@umssy.local
MAIL_FROM_NAME=UMSSY
MAIL_REPLY_TO=
# alternativa: https://dev-umssy.zer4c.dev/icons/umssy-logo-web.svg
MAIL_LOGO_URL=https://umssy.zer4c.dev/icons/umssy-logo-web.svg

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=