# Servidor
PORT=8080
NODE_ENV=development

# Base de datos (valores de desarrollo local, los mismos que usa compose.yml)
DB_USER=user
DB_PASSWORD=password_db
DB_NAME=app_db
DB_PORT=5432
DB_HOST=localhost
DB_SCHEMA=public

# Tiempo máximo de cada transacción de módulo del seed en ms (1 a 600000; por defecto 120000)
SEED_TRANSACTION_TIMEOUT_MS=120000

# Autenticación (JWT_SECRET va vacío: genéralo como indica el README)
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ALGORITHM=HS256

# CORS (origen del frontend en desarrollo)
CORS_ORIGIN=http://localhost:3000
MAIL_TRANSPORT=mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=hu7@umssy.test
MENTOR_ABUSE_THRESHOLD=5
MENTOR_ABUSE_WINDOW_HOURS=24
MENTOR_SANCTION_HOURS=72
