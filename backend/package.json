{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "prepare": "cd .. && husky",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-mail-templates.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migrate": "prisma migrate dev --name",
    "migrate:apply": "prisma migrate deploy && prisma generate",
    "seed": "prisma db seed",
    "seed:run": "tsc -p tsconfig.seed.json && node dist-seed/src/common/database/development-seeds.js",
    "seed:production": "tsc -p tsconfig.seed.json && node dist-seed/src/common/database/catalog-seeds.js",
    "vercel-build": "prisma generate && pnpm vercel:migrate && pnpm build",
    "vercel:migrate": "sh -c 'if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; else echo \"vercel:migrate skipped (VERCEL_ENV=$VERCEL_ENV)\"; fi'",
    "generate": "prisma generate",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "dotenv run -f .env.test -- vitest run --config ./vitest.config.e2e.ts",
    "migrate:test:apply": "dotenv run -f .env.test -- pnpm migrate:apply",
    "test:all": "concurrently \"pnpm test\" \"pnpm test:e2e\"",
    "lint:standards": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "seed:catalogs": "pnpm run seed:production",
    "seed:admin": "tsc -p tsconfig.seed.json && node dist-seed/src/common/database/production-seeds.js",
    "ocr:models": "node scripts/prepare-ocr-models.ts",
    "ocr:smoke": "node scripts/ocr-smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "12.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-check-file": "^3.3.2",
    "helmet": "^8.3.0",
    "mjml": "^5.4.1",
    "mupdf": "^1.28.6",
    "nestjs-zod": "^5.6.0",
    "nodemailer": "^10.6.1",
    "paddleocr": "^1.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "tesseract.js": "^6.0.1",
    "typescript-eslint": "^8.74.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mjml": "5.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.24.3"
  }
}
