FROM node:22-alpine AS builder

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@12.4.2 --activate

WORKDIR /build

COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm generate
RUN pnpm run build


FROM node:22-alpine

RUN apk add --no-cache openssl curl
WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder --chown=appuser:appgroup /build/node_modules ./node_modules
COPY --from=builder --chown=appuser:appgroup /build/dist ./dist
COPY --from=builder --chown=appuser:appgroup /build/package.json ./
COPY --from=builder --chown=appuser:appgroup /build/prisma ./prisma
COPY --from=builder --chown=appuser:appgroup /build/prisma7.config.ts ./prisma7.config.ts
COPY --from=builder --chown=appuser:appgroup /build/src/common/prisma/build-connection-string.ts ./src/common/prisma/build-connection-string.ts

ENV NODE_ENV=production \
  PORT=8080

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT}/api/ || exit 1

EXPOSE ${PORT}

CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/main.js"]
