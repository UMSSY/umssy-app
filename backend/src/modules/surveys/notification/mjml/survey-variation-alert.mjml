<mj-section padding="8px 24px">
  <mj-column>
    <mj-text mj-class="heading">Alerta de variación significativa</mj-text>
    <mj-text
      >Hola {{ recipientName }}, detectamos cambios significativos en los
      resultados de la encuesta <strong>«{{ surveyTitle }}»</strong> frente al
      semestre anterior (umbral: {{ threshold }} pp).</mj-text
    >
    <mj-text font-weight="700" color="#003770" padding="12px 0 4px"
      >Resumen de variaciones detectadas</mj-text
    >
    <mj-text padding="0 0 16px"
      ><div
        style="
          white-space: pre-wrap;
          font-family: monospace, sans-serif;
          font-size: 13px;
        "
      >
        {{ shiftsContent }}
      </div></mj-text
    >
    <mj-button href="{{ actionUrl }}">Ver analíticas</mj-button>
  </mj-column>
</mj-section>
