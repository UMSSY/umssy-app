<mj-section padding="8px 24px">
  <mj-column>
    <mj-text mj-class="heading">Observaciones en tu solicitud</mj-text>
    <mj-text>La administración revisó la solicitud de {{ companyName }} y solicitó subsanar la información registrada.</mj-text>
    <mj-text mj-class="secondary">Código de solicitud: {{ requestCode }}</mj-text>
    <mj-text font-weight="700" color="#B4050F" padding="12px 16px 4px" container-background-color="#FDEEEF">Motivo de observación</mj-text>
    <mj-text padding="0 16px 12px" container-background-color="#FDEEEF"><div style="white-space: pre-wrap;">{{ reason }}</div></mj-text>
    <mj-text padding="16px 0">Consulta el estado con tu código de seguimiento para realizar las correcciones necesarias.</mj-text>
    <mj-button href="{{ requestStatusUrl }}">Consultar estado</mj-button>
  </mj-column>
</mj-section>
